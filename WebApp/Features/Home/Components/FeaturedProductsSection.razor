@using MerdasGold.Features.Catalog.Services
@inject StorefrontCatalogService Catalog
<section class="products-section storefront-section" id="products">
    <StorefrontSectionTitle Kicker="MERDAS" Title="جدیدترین محصولات" />
    <div class="product-grid storefront-container">
        @foreach (var product in _products)
        {
            <ProductCard Title="@product.Title" Price="@product.Price" ImageUrl="@product.ImageUrl" Href="@product.Href" />
        }
    </div>
</section>
@code {
    private IReadOnlyList<StorefrontProductCard> _products = [];
    protected override async Task OnInitializedAsync() => _products = await Catalog.FeaturedAsync();
}
