<section class="categories-section storefront-section" id="categories">
    <StorefrontSectionTitle Kicker="categories" Title="دسته‌بندی محصولات" />

    <div class="categories storefront-container">
        @foreach (var category in _categories)
        {
            <CategoryCard Title="@category.Name" ImageUrl="@category.ImageUrl" Href="@($"/products/category/{category.Slug}")" />
        }
    </div>

    <div class="features storefront-container" aria-label="مزایای خرید از مرداس">
        @foreach (var benefit in Benefits)
        {
            <article>
                <img src="@benefit.ImageUrl" alt="" width="400" height="400" loading="lazy" />
                <div><h3>@benefit.Title</h3><p>@benefit.Description</p></div>
            </article>
        }
    </div>
</section>

@code {
    [Inject] private MerdasGold.Features.Catalog.Services.CatalogService Catalog { get; set; } = default!;
    private IReadOnlyList<MerdasGold.Features.Catalog.Models.HomeCategoryItem> _categories = [];
    protected override async Task OnInitializedAsync() => _categories = await Catalog.GetHomeCategoriesAsync();

    private static readonly BenefitItem[] Benefits =
    [
        new("قیمت مناسب", "حفظ کیفیت مناسب در کنار قیمت", "/assets/storefront/images/35.png"),
        new("تضمین کیفیت کالا", "ساختار زیبا و منحصر به فرد محصولات", "/assets/storefront/images/1412.png"),
        new("تنوع محصولات", "محصولاتی برای هر سلیقه‌ای", "/assets/storefront/images/ad-1.png")
    ];

    private sealed record BenefitItem(string Title, string Description, string ImageUrl);
}
