@inject MerdasGold.Features.Content.Services.BlogService Blog
@using MerdasGold.Features.Content.Models
@using MerdasGold.Features.Content.Components

@if (_articles.Count > 0)
{
    <section class="blog-section storefront-section" id="blog">
        <StorefrontSectionTitle Kicker="journal" Title="بلاگ مرداس" />
        <div class="storefront-container"><BlogCards Items="_articles" /><div class="all-articles"><a href="/blog">همه نوشته‌های مرداس ←</a></div></div>
    </section>
}
@code {
    private IReadOnlyList<BlogCard> _articles = [];
    protected override async Task OnInitializedAsync() => _articles = await Blog.ListAsync(size: 3);
}
