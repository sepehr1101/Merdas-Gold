@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        Navigation.NavigateTo(path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
            ? "/login" : "/customer/login?returnUrl=" + Uri.EscapeDataString(path), forceLoad: true);
    }
}
