@page "/admin/pricing"
@page "/admin/pricing/{Section}"
@layout AdminLayout
@attribute [Authorize(Roles = "Administrator")]
@using MerdasGold.Features.Pricing.Entities
@using MerdasGold.Features.Pricing.Services

<PageTitle>فروش و قیمت‌گذاری | مرداس</PageTitle>
<section class="pricing-page">
    @if (Active == "overview")
    {
        <header class="admin-hub-hero">
            <div class="admin-hub-hero-copy">
                <span class="admin-hub-eyebrow"><MudIcon Icon="@Icons.Material.Outlined.CurrencyExchange" Size="Size.Small" /> مدیریت فروشگاه</span>
                <h1 class="admin-hub-title">فروش و قیمت‌گذاری</h1>
            </div>
            <div class="admin-hub-emblem" aria-hidden="true"><span></span><MudIcon Icon="@Icons.Material.Outlined.PriceChange" /></div>
        </header>
        <div class="admin-hub-grid">
            <a class="admin-hub-card accent-blue" href="/admin/pricing/rates"><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.CurrencyExchange" /></span><div class="admin-hub-copy"><h2>نرخ طلا</h2><p>دریافت خودکار، نرخ دستی و سابقه نرخ‌ها</p></div><span class="admin-hub-footer">مدیریت نرخ <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" /></span></a>
            <a class="admin-hub-card accent-green" href="/admin/pricing/discounts"><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.LocalOffer" /></span><div class="admin-hub-copy"><h2>تخفیف‌ها</h2><p>تعریف و مدیریت تخفیف اجرت کالاها</p></div><span class="admin-hub-footer">مدیریت تخفیف <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" /></span></a>
            <a class="admin-hub-card accent-gold" href="/admin/pricing/rules"><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.Calculate" /></span><div class="admin-hub-copy"><h2>قواعد قیمت‌گذاری</h2><p>مالیات، گرد کردن و محاسبه آزمایشی قیمت</p></div><span class="admin-hub-footer">مدیریت قواعد <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" /></span></a>
        </div>
    }
    else
    {
        <header class="pricing-section-header"><a href="/admin/pricing"><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /> فروش و قیمت‌گذاری</a><h1>@Tabs.First(tab => tab.Key == Active).Title</h1></header>
    }
    @if (_message is not null) { <div class="notice @(_failed ? "failure" : "")" role="status">@_message</div> }
    @if (Active == "overview") { }
    else if (_settings is null || _rule is null) { <MudProgressLinear Indeterminate="true" /> }
    else if (Active == "rates")
    {
        <div class="rate-banner"><div><span>هر گرم طلای ۱۸ عیار</span><strong>@(_current?.PriceToman?.ToString("N0") ?? "—") <small>تومان</small></strong><p>زمان نرخ: @LocalTime(_current?.SourceUtc) · منبع: @GoldProviderNames.DisplayName(_current?.Provider ?? _settings.Provider)</p></div><span class="badge @(Fresh ? "good" : "warning")">@(Fresh ? (_current?.Provider == "دستی" ? "نرخ دستی فعال" : "نرخ معتبر") : "نرخ معتبر در دسترس نیست")</span><button class="primary" disabled="@_busy" @onclick="Fetch">دریافت نرخ جدید</button></div>
        <div class="schedule-strip" aria-live="polite">
            <div><span>آخرین تلاش</span><strong>@LocalTime(_schedule?.LastAttemptUtc)</strong></div>
            <div><span>آخرین دریافت موفق</span><strong>@LocalTime(_schedule?.LastSuccessUtc)</strong></div>
            <div><span>اجرای بعدی</span><strong>@NextRunText</strong></div>
            <span class="badge @(_schedule?.CredentialsConfigured == true ? "good" : "warning")">@(_schedule?.CredentialsConfigured == true ? "اعتبارنامه آماده" : "اعتبارنامه تنظیم نشده")</span>
        </div>
        @if (!Fresh) { <p class="hint">محاسبه با نرخ زنده تا دریافت نرخ معتبر متوقف است. پیش‌نمایش فرضی همچنان قابل استفاده است.</p> }
        <div class="two-columns">
            <article class="card"><h2>دریافت خودکار نرخ</h2>
                <EditForm Model="_settings" OnValidSubmit="SaveSettings" FormName="rate-settings">
                    <ValidationSummary /><fieldset disabled="@_busy"><label>تأمین‌کننده<select @bind="_settings.Provider"><option value="@GoldProviderNames.TabanGohar">تابان گوهر نفیس</option><option value="@GoldProviderNames.Navasan">نوسان</option></select></label>
                    @if (_settings.Provider == GoldProviderNames.Navasan) { <label>کلید API<input type="password" autocomplete="new-password" @bind="_apiKey" maxlength="500" placeholder="@(_settings.ProtectedApiKey.Length > 0 ? "کلید ذخیره شده است" : "کلید سرویس را وارد کنید")" /></label> }
                    else { <p class="hint">نام کاربری و رمز تابان گوهر از تنظیمات امن محیط اجرا خوانده می‌شود و در دیتابیس یا سابقه عملیات نمایش داده نمی‌شود.</p> }
                    <div class="field-grid"><label>فاصله دریافت<select @bind="_settings.IntervalMinutes"><option value="1">هر ۱ دقیقه</option><option value="5">هر ۵ دقیقه</option><option value="15">هر ۱۵ دقیقه</option></select></label><label>اعتبار نرخ (دقیقه)<InputNumber @bind-Value="_settings.MaxAgeMinutes" min="1" max="1440" /></label></div>
                    <div class="field-grid"><label>واحد پاسخ تأمین‌کننده<select @bind="_settings.SourceUnit"><option value="toman">تومان</option><option value="rial">ریال؛ تبدیل خودکار به تومان</option></select></label><label>نگهداری تاریخچه (روز)<InputNumber @bind-Value="_settings.RetentionDays" min="7" max="365" /></label></div>
                    <label class="check"><InputCheckbox @bind-Value="_settings.Enabled" /> دریافت خودکار فعال باشد</label><button class="primary" type="submit">ذخیره تنظیمات</button></fieldset>
                </EditForm>
            </article>
            <article class="card"><h2>نرخ دستی موقت</h2>
                <EditForm Model="_settings" OnValidSubmit="SaveManual" FormName="manual-rate"><ValidationSummary /><fieldset disabled="@_busy"><label>قیمت هر گرم (تومان)<InputNumber @bind-Value="_manualPrice" min="1" /></label><label>اعتبار (دقیقه)<InputNumber @bind-Value="_manualMinutes" min="1" max="1440" /></label><label>دلیل ثبت<input @bind="_manualReason" maxlength="200" /></label><div class="actions"><button class="primary" type="submit">فعال‌سازی نرخ دستی</button><button class="secondary" type="button" @onclick="ClearManual">پایان نرخ دستی</button></div></fieldset></EditForm>
                @if (_settings.ManualExpiresUtc.HasValue) { <p class="hint">انقضا: @LocalTime(_settings.ManualExpiresUtc)</p> }
            </article>
        </div>
        <article class="card"><div class="section-heading"><div><h2>سابقه دریافت نرخ</h2></div><span class="badge">@_rateCount ردیف</span></div>
            <div class="filters"><label>روز شمسی<input @bind="_rateDay" placeholder="۱۴۰۵/۰۶/۱۹" /></label><label>از ساعت<input type="time" @bind="_fromTime" /></label><label>تا ساعت<input type="time" @bind="_toTime" /></label><button class="secondary" disabled="@_busy" @onclick="SearchRates">نمایش</button></div>
            <p class="hint">رکوردهای قدیمی‌تر از @_settings.RetentionDays روز به‌صورت خودکار حذف می‌شوند.</p>
            <div class="table-scroll"><table><thead><tr><th>دریافت · تهران</th><th>زمان نرخ · تهران</th><th>قیمت / تومان</th><th>منبع</th><th>وضعیت</th></tr></thead><tbody>@foreach (var rate in _history) { <tr><td>@LocalTime(rate.ReceivedUtc)</td><td>@LocalTime(rate.SourceUtc)</td><td>@rate.PriceToman?.ToString("N0")</td><td>@GoldProviderNames.DisplayName(rate.Provider)</td><td>@rate.Status</td></tr> }</tbody></table></div>
            @if (_history.Count == 0) { <div class="empty">در این بازه دریافتی ثبت نشده است.</div> }
            <div class="pagination"><button class="secondary" disabled="@(_ratePage == 0 || _busy)" @onclick="PreviousRates">قبلی</button><span>صفحه @(_ratePage + 1)</span><button class="secondary" disabled="@((_ratePage + 1) * 30 >= _rateCount || _busy)" @onclick="NextRates">بعدی</button></div>
        </article>
    }
    else if (Active == "rules")
    {
        <article class="card general-rule">
                <h2>قاعده عمومی فروشگاه</h2>
                <EditForm Model="_rule" OnValidSubmit="SaveRule" FormName="pricing-rule">
                    <ValidationSummary />
                    <fieldset disabled="@_busy">
                        <div class="rule-fields">
                            <label>درصد پیش‌فرض مالیات بر ارزش افزوده<InputNumber @bind-Value="_rule.TaxPercent" min="0" max="100" step="0.01" /><small>بر اجرت پس از تخفیف محاسبه می‌شود.</small></label>
                            <label>گرد کردن مبلغ نهایی<select @bind="RoundingUnit"><option value="1">نزدیک‌ترین تومان</option><option value="100">نزدیک‌ترین ۱۰۰ تومان</option><option value="1000">نزدیک‌ترین ۱٬۰۰۰ تومان</option><option value="10000">نزدیک‌ترین ۱۰٬۰۰۰ تومان</option></select></label>
                            <button class="admin-form-submit" type="submit">ذخیره قاعده قیمت‌گذاری</button>
                        </div>
                    </fieldset>
                </EditForm>
            </article>
        <article class="card invoice-footer-card no-print">
            <h2>قالب صورتحساب</h2>
            <EditForm Model="_rule" OnValidSubmit="SaveRule" FormName="invoice-settings">
                <ValidationSummary />
                <fieldset disabled="@_busy">
                    <div class="invoice-footer-row">
                        <label>متن پایین صورتحساب<textarea rows="2" maxlength="500" @bind="_rule.InvoiceFooter"></textarea></label>
                        <button class="admin-form-submit" type="submit">ذخیره متن</button>
                    </div>
                </fieldset>
            </EditForm>
            <a href="/admin/settings/store">ویرایش لوگو و نشانی فروشگاه</a>
        </article>
        <div class="invoice-workspace">
            <article class="card invoice-controls no-print">
                <h2>داده آزمایشی و قالب صورتحساب</h2>
                <div class="field-grid">
                    <label>قطعه کاتالوگ<select value="@_pieceId" @onchange="SelectPiece"><option value="0">وزن دلخواه برای آزمایش</option>@foreach (var piece in _pieces) { <option value="@piece.Id">@piece.Title · @piece.Weight گرم</option> }</select></label>
                    <label>وزن طلای ۱۸ عیار (گرم)<input type="number" step="0.001" min="0.001" @bind="_weight" /></label>
                    <label>اجرت این کالا (درصد)<input type="number" step="0.0001" min="0" max="100" @bind="_previewFeePercent" /></label>
                    <label>سود فروشنده این کالا (درصد)<input type="number" step="0.0001" min="0" max="100" @bind="_previewProfitPercent" /></label>
                </div>
                <label class="check"><input type="checkbox" @bind="_useLive" /> استفاده از نرخ معتبر فعلی</label>
                @if (!_useLive) { <label>نرخ فرضی هر گرم (تومان)<input type="number" min="1" @bind="_sampleRate" /></label><p class="hint">این نرخ فقط برای آزمایش است و ذخیره نمی‌شود.</p> }
                <button class="primary" type="button" @onclick="ShowInvoice">نمایش صورتحساب</button>
            </article>
            <div class="invoice-result">
                @if (_invoicePreview is { } invoice)
                {
                    <div class="invoice-actions no-print"><button class="secondary" type="button" @onclick="Print">چاپ / ذخیره PDF</button></div>
                    <article class="invoice-paper" id="invoice-preview">
                        <div class="invoice-top">@if (_hasLogo) { <img src="/store-assets/logo" alt="لوگوی فروشگاه" /> } else { <span class="invoice-monogram">م</span> }<div><h2>@_storeName</h2><p>@_storeAddress</p></div><span class="sample-stamp">نمونه</span></div>
                        <div class="invoice-title"><h2>صورتحساب فروش طلا</h2><span>شماره: پیش‌نمایش<br />تاریخ: @LocalTime(_invoiceDateUtc)</span></div>
                        <p>خریدار: مشتری نمونه · عیار: ۱۸ · واحد پول: تومان</p>
                        <div class="table-scroll"><table><thead><tr><th>شرح</th><th>وزن</th><th>نرخ هر گرم</th><th>قیمت اصلی محصول</th></tr></thead><tbody><tr><td>@_invoicePieceTitle</td><td>@_invoiceWeight.ToString("N3") گرم</td><td>@Money(_invoiceRate)</td><td>@Money(invoice.ProductPrice)</td></tr></tbody></table></div>
                        <dl class="breakdown"><dt>اجرت</dt><dd>@Money(invoice.Fee)</dd><dt>تخفیف اجرت</dt><dd>@Money(invoice.Discount)</dd><dt>مالیات</dt><dd>@Money(invoice.Tax)</dd><dt>تعدیل گرد کردن</dt><dd>@Money(invoice.Rounding)</dd><dt class="total">جمع قابل پرداخت</dt><dd class="total">@Money(invoice.Total) تومان</dd></dl>
                        <footer><p>@_invoiceFooter</p><small>اطلاعات آزمایشی برای نمایش قالب؛ فاقد اعتبار مالی و مالیاتی.</small></footer>
                    </article>
                }
                else { <div class="invoice-placeholder">داده آزمایشی را وارد کنید و «نمایش صورتحساب» را بزنید.</div> }
            </div>
        </div>
    }
    else if (Active == "discounts")
    {
        <div class="two-columns"><article class="card"><h2>@(_discount.Id == 0 ? "تخفیف جدید" : "ویرایش تخفیف")</h2>
            <EditForm Model="_discount" OnValidSubmit="SaveDiscount" FormName="discount"><ValidationSummary /><fieldset disabled="@_busy"><label>عنوان<input @bind="_discount.Title" maxlength="100" /></label><label>نوع<select @bind="_discount.Kind"><option value="percent">درصد از اجرت</option><option value="fixed">مبلغ ثابت از اجرت (تومان)</option></select></label><label>مقدار<InputNumber @bind-Value="_discount.Value" min="0" /></label><div class="field-grid"><label>شروع (شمسی)<input @bind="_discountStart" placeholder="۱۴۰۵/۰۶/۱۹" /></label><label>پایان (شمسی، شامل این روز)<input @bind="_discountEnd" placeholder="۱۴۰۵/۰۶/۲۶" /></label></div><label class="check"><InputCheckbox @bind-Value="_discount.Enabled" /> فعال</label><div class="actions"><button class="primary" type="submit">ذخیره تخفیف</button><button class="secondary" type="button" @onclick="NewDiscount">تخفیف تازه</button></div></fieldset></EditForm>
        </article><article class="card"><h2>تخفیف‌های فروشگاه</h2>@if (_discounts.Count == 0) { <div class="empty"><MudIcon Icon="@Icons.Material.Outlined.LocalOffer" /><h3>اولین تخفیف، ساده و روشن</h3></div> }
            @foreach (var discount in _discounts) { <div class="discount-item"><div><strong>@discount.Title</strong><p>@Money(discount.Value) @(discount.Kind == "percent" ? "درصد" : "تومان") از اجرت</p><small>@DiscountStatus(discount) · پایان @LocalTime(discount.EndsUtc.AddSeconds(-1))</small></div><button class="secondary" @onclick="() => EditDiscount(discount)">ویرایش</button></div> }
        </article></div>
    }
</section>
