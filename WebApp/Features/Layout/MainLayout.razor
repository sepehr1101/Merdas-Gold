@inherits LayoutComponentBase

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="MerdasTheme.Default" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <div class="storefront-shell">
        <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
        <header class="storefront-header">
            <a class="storefront-brand" href="/" aria-label="مرداس گلد، صفحه اصلی">
                <span class="brand-gem" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Diamond" /></span>
                <span><strong>مرداس گلد</strong><small lang="en" dir="ltr">MERDAS GOLD</small></span>
            </a>
            <nav class="storefront-nav" aria-label="ناوبری اصلی">
                <a href="/#collection">محصولات</a>
                <a href="/#services">خدمات</a>
                <a href="/#about">درباره مرداس</a>
            </nav>
            <a class="storefront-account" href="/login"><MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" /><span>ورود مدیر</span></a>
        </header>
        <main id="main-content" class="storefront-main">@Body</main>
        <footer class="storefront-footer"><span>مرداس گلد؛ انتخابی مطمئن برای طلای ماندگار</span><span lang="en" dir="ltr">© @DateTime.Now.Year MERDAS GOLD</span></footer>
    </div>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <button type="button" class="dismiss" aria-label="بستن">×</button>
</div>

