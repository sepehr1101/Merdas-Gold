@inherits LayoutComponentBase

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="MerdasTheme.Default" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
                <MudText Typo="Typo.h6">مرداس گلد</MudText>
            </MudLink>
        </MudAppBar>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <button type="button" class="dismiss" aria-label="بستن">×</button>
</div>
