@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject StorefrontUiState UiState
@inject IJSRuntime Js
@inject NavigationManager Navigation

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="StorefrontTheme.Default" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <div class="storefront-shell">
        <div class="navigation-progress @(_navigationTarget is null ? null : "navigation-progress--active")"
             role="progressbar" aria-label="در حال باز کردن صفحه" aria-hidden="@(_navigationTarget is null).ToString().ToLowerInvariant()">
            <span></span>
        </div>
        <a class="skip-link" href="#storefront-content">رفتن به محتوای اصلی</a>
        <StorefrontHeader />
        <main id="storefront-content" class="storefront-main">@Body</main>
        <StorefrontFooter />

        <button id="storefront-back-top" class="back-top" type="button" aria-label="بازگشت به بالا" @onclick="ScrollToTop">⌃</button>

        <div class="toast @(ToastVisible ? "toast--visible" : null)" role="status" aria-live="polite">
            @ToastMessage
        </div>
    </div>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <button type="button" class="dismiss" aria-label="بستن">×</button>
</div>

@code {
    private CancellationTokenSource? _toastCancellation;
    private IDisposable? _navigationRegistration;
    private string? _navigationTarget;
    private bool _scrollInteropInitialized;
    private string ToastMessage { get; set; } = string.Empty;
    private bool ToastVisible { get; set; }

    protected override void OnInitialized()
    {
        UiState.NotificationRequested += ShowToast;
        _navigationRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UiState.InitializeAsync();
            await Js.InvokeVoidAsync("storefrontScroll.initialize", "storefront-back-top");
            _scrollInteropInitialized = true;
        }

        if (_navigationTarget is not null && SameLocation(Navigation.Uri, _navigationTarget))
        {
            _navigationTarget = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        _navigationTarget = context.TargetLocation;
        await InvokeAsync(StateHasChanged);
    }

    private bool SameLocation(string current, string target)
        => string.Equals(Navigation.ToAbsoluteUri(current).PathAndQuery,
            Navigation.ToAbsoluteUri(target).PathAndQuery, StringComparison.Ordinal);

    private async Task ScrollToTop() => await Js.InvokeVoidAsync("storefrontScroll.toTop");

    private async void ShowToast(string message)
    {
        _toastCancellation?.Cancel();
        _toastCancellation?.Dispose();
        _toastCancellation = new CancellationTokenSource();
        var cancellationToken = _toastCancellation.Token;

        ToastMessage = message;
        ToastVisible = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(2200), cancellationToken);
            ToastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        UiState.NotificationRequested -= ShowToast;
        _navigationRegistration?.Dispose();
        _toastCancellation?.Cancel();
        _toastCancellation?.Dispose();

        if (!_scrollInteropInitialized)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("storefrontScroll.dispose", "storefront-back-top");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
