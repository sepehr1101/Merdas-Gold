@inject MerdasGold.Features.StoreInformation.Services.StoreInformationService StoreInformationService

<footer class="site-footer">
    <div class="footer-top storefront-container">
        <div class="footer-brand">
            <StorefrontBrand Inverse="true" />
            <p>زیبایی ماندگار، انتخاب مطمئن؛ همراه شما برای انتخاب قطعه‌ای که به قصه‌تان معنا می‌دهد.</p>
        </div>

        <nav aria-label="دسترسی سریع">
            <h2>دسترسی سریع</h2>
            <a href="/#products">فروشگاه</a>
            <a href="/about">درباره ما</a>
            <a href="/#blog">مجله</a>
            <a href="/contact">تماس با ما</a>
        </nav>

        <nav aria-label="خدمات مشتریان">
            <h2>خدمات مشتریان</h2>
            <a href="/rules">قوانین فروشگاه</a>
            <a href="/buying-guide">راهنمای خرید</a>
            <a href="/shipment-tracking">پیگیری ارسال</a>
            <a href="/contact#faq">سؤالات متداول</a>
        </nav>

        <div class="contact">
            <h2>با ما در تماس باشید</h2>
            @if (_contact is not null)
            {
                <a href="tel:@_contact.PhoneHref" dir="ltr">@_contact.PhoneNumber</a>
                <p>@_contact.Address</p>
            }
            <small>شنبه تا پنجشنبه، ۱۰ تا ۲۰</small>
        </div>
    </div>

    <div class="footer-bottom storefront-container">
        <p>© ۱۴۰۵ مرداس گلد؛ تمامی حقوق محفوظ است.</p>
        <p lang="en" dir="ltr">Designed for enduring beauty.</p>
    </div>
</footer>

@code {
    private MerdasGold.Features.StoreInformation.Models.StorefrontContactModel? _contact;

    protected override async Task OnInitializedAsync() =>
        _contact = await StoreInformationService.GetStorefrontContactAsync();
}
