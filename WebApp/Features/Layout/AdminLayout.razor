@inherits LayoutComponentBase

<div class="admin-shell">
    <MudRTLProvider RightToLeft="true">
        <MudThemeProvider Theme="MerdasTheme.Default" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <MudLayout>
            <MudAppBar Fixed="true" Dense="true" Elevation="0" Class="admin-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="باز و بسته کردن منو"
                           OnClick="ToggleDrawer" />
            <AuthorizeView>
                <Authorized Context="authenticationState">
                    <MudText Typo="Typo.h6" Class="admin-title">
                        @authenticationState.User.Identity?.Name
                    </MudText>
                </Authorized>
            </AuthorizeView>
            <MudSpacer />
            <PageHelpButton />
            <MudIconButton Icon="@Icons.Material.Outlined.NotificationsNone"
                           Color="Color.Inherit"
                           aria-label="اعلان‌ها" />
            <MudMenu Icon="@Icons.Material.Outlined.AccountCircle"
                     Color="Color.Inherit"
                     AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft"
                     aria-label="حساب کاربری">
                <MudMenuItem Href="/admin/profile" Icon="@Icons.Material.Outlined.Person">پروفایل من</MudMenuItem>
                <MudDivider />
                <form method="post" action="/account/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <button class="admin-logout" type="submit">
                        <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                        <span>خروج</span>
                    </button>
                </form>
            </MudMenu>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen"
                       Anchor="Anchor.Right"
                       Variant="DrawerVariant.Responsive"
                       Width="252px"
                       Elevation="1"
                       Class="admin-drawer">
                <AdminNavMenu />
            </MudDrawer>

            <MudMainContent Class="admin-content">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="admin-container">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </MudRTLProvider>
</div>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <button type="button" class="dismiss" aria-label="بستن">×</button>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
