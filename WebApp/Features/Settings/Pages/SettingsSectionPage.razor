@page "/admin/settings/{Section}"
@layout AdminLayout
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>@Title | مرداس گلد</PageTitle>

<section class="section-page">
    <a class="back-link" href="/admin/settings">
        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
        <span>بازگشت به تنظیمات</span>
    </a>
    <div class="section-placeholder">
        <span class="section-icon"><MudIcon Icon="@Icon" Size="Size.Large" /></span>
        <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">جزئیات این بخش در مرحله بعد اضافه می‌شود.</MudText>
    </div>
</section>

@code {
    [Parameter] public string Section { get; set; } = string.Empty;

    private string Title => Section switch
    {
        "users" => "کاربران",
        "security" => "امنیت",
        "audit-logs" => "لاگ عملیات‌ها",
        "store" => "اطلاعات فروشگاه",
        "backups" => "پشتیبان‌گیری",
        "notifications" => "اعلان‌ها",
        "about" => "درباره نرم‌افزار",
        _ => "تنظیمات"
    };

    private string Icon => Section switch
    {
        "users" => Icons.Material.Outlined.PeopleAlt,
        "security" => Icons.Material.Outlined.Security,
        "audit-logs" => Icons.Material.Outlined.ManageSearch,
        "store" => Icons.Material.Outlined.Storefront,
        "backups" => Icons.Material.Outlined.Backup,
        "notifications" => Icons.Material.Outlined.NotificationsActive,
        _ => Icons.Material.Outlined.Info
    };
}
