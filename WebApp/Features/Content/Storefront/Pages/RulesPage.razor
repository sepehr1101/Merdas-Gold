@page "/rules"
@layout StorefrontLayout
@inject MerdasGold.Features.Content.Services.ContentManagementService ContentService

<PageTitle>قوانین فروشگاه | مرداس گلد</PageTitle>

<section class="inner-content">
    <div class="storefront-container">
        @if (_policy is not null)
        {
            <header class="rules-header">
                <h1>@_policy.Title</h1>
                @if (!string.IsNullOrWhiteSpace(_policy.Summary)) { <p>@_policy.Summary</p> }
            </header>
            <ol class="rules-list">
                @foreach (var section in Sections)
                {
                    <li>
                        <h2>@section.Title</h2>
                        @foreach (var paragraph in section.Paragraphs) { <p>@paragraph</p> }
                    </li>
                }
            </ol>
        }
    </div>
</section>

@code {
    private MerdasGold.Features.Content.Models.StorefrontPolicyModel? _policy;
    private IReadOnlyList<PolicySection> Sections { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        _policy = await ContentService.GetPublishedPolicyAsync("store-rules");
        Sections = _policy is null ? [] : ParseSections(_policy.Content);
    }

    private static IReadOnlyList<PolicySection> ParseSections(string content)
    {
        var sections = new List<PolicySection>();
        PolicySection? current = null;
        foreach (var rawLine in content.Replace("\r", string.Empty).Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0) continue;
            var separator = line.IndexOf(". ", StringComparison.Ordinal);
            if (separator > 0 && line[..separator].All(ch => char.IsDigit(ch) || ch is >= '۰' and <= '۹'))
            {
                current = new PolicySection(line[(separator + 2)..], []);
                sections.Add(current);
            }
            else if (current is not null)
            {
                current.Paragraphs.Add(line);
            }
        }
        return sections;
    }

    private sealed record PolicySection(string Title, List<string> Paragraphs);
}
