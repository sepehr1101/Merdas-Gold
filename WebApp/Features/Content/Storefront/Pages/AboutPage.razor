@page "/about"
@layout StorefrontLayout
@inject MerdasGold.Features.StoreInformation.Services.StoreInformationService StoreInformationService

<PageTitle>درباره ما | مرداس گلد</PageTitle>

<section class="inner-content">
    <div class="storefront-container">
        <div class="about-page">
            <div class="about-photo">
                <img src="/assets/storefront/images/insta-03.jpg"
                     alt="گالری طلا و جواهر مرداس"
                     width="800"
                     height="846" />
                <span class="about-badge" aria-hidden="true">MERDAS</span>
            </div>

            <div class="about-page-copy">
                <small lang="en" dir="ltr">@_about.EnglishName</small>
                <h1>@_about.StoreName</h1>
                @foreach (var paragraph in Paragraphs(_about.Description))
                {
                    <p>@paragraph</p>
                }
                <a class="storefront-action" href="/#products">مشاهده محصولات</a>
            </div>
        </div>
    </div>
</section>

@code {
    private MerdasGold.Features.StoreInformation.Models.StorefrontAboutModel _about = new("طلای مرداس", "Merdas Gold", string.Empty);

    protected override async Task OnInitializedAsync() =>
        _about = await StoreInformationService.GetStorefrontAboutAsync();

    private static IEnumerable<string> Paragraphs(string description) =>
        description.Replace("\r", string.Empty)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
