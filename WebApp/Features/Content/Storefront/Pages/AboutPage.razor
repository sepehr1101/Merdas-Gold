@page "/about"
@layout StorefrontLayout

<PageTitle>درباره ما | مرداس گلد</PageTitle>

<section class="inner-content">
    <div class="storefront-container">
        <div class="about-page">
            <div class="about-photo">
                <img src="/assets/storefront/images/insta-03.jpg"
                     alt="گالری طلا و جواهر مرداس"
                     width="800"
                     height="846" />
                <span class="about-badge" aria-hidden="true">MERDAS</span>
            </div>

            <div class="about-page-copy">
                <small lang="en" dir="ltr">MERDAS</small>
                <h1>گالری مرداس</h1>
                <p>مفتخریم که از سال ۱۳۸۸ در عرصه طراحی و تولید طلا و جواهر فعال بوده و به‌صورت پخش عمده بین بنکداران و مغازه‌داران تهران و شهرستان فعالیت داشتیم. در سال ۱۳۹۴ تصمیم گرفتیم که با حذف واسطه و ارتباط مستقیم بین تولیدکننده و مصرف‌کننده، تولیدات خود را با قیمت بسیار مناسب به دست مصرف‌کننده برسانیم.</p>
                <p>خداوند را شاکریم که با کسب جواز تولید سالیانه ۱۰۰ کیلوگرم مصنوعات زینتی از طلا، خدمتگزار مردم عزیز هستیم. تلاش ما بر این است که با همراهی شما دوستان در راه برآورده کردن خواسته‌های هموطنان از نظر تنوع مدل، کیفیت بالا و قیمت مناسب گام برداریم.</p>
                <a class="storefront-action" href="/#products">مشاهده محصولات</a>
            </div>
        </div>

        <div class="about-values" aria-label="ارزش‌های مرداس">
            <article>
                <b>از ۱۳۸۸</b>
                <span>تجربه طراحی و تولید</span>
            </article>
            <article>
                <b>کیفیت بالا</b>
                <span>تضمین ساخت محصولات</span>
            </article>
            <article>
                <b>بدون واسطه</b>
                <span>قیمت مناسب برای مصرف‌کننده</span>
            </article>
        </div>
    </div>
</section>
