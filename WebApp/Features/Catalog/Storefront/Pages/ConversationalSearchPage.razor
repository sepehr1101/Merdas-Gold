@page "/products/search"
@layout StorefrontLayout
@using MerdasGold.Features.Catalog.Services
@inject StorefrontCatalogService Catalog
@inject DeepSeekProductSearchService AiSearch
@inject NavigationManager Navigation

<PageTitle>جست‌وجوی طلا | مرداس</PageTitle>
<div class="search-page">
    <section class="search-hero" aria-labelledby="search-title">
        <div class="storefront-container">
            <nav aria-label="مسیر صفحه"><a href="/">خانه</a><span aria-hidden="true"> / </span><span aria-current="page">جست‌وجو</span></nav>
            <h1 id="search-title">چه طلایی در ذهن دارید؟</h1>
            <p>با زبان خودتان بنویسید؛ مثلاً «گردنبند ظریف رزگلد».</p>
            <form role="search" @onsubmit="Search" @onsubmit:preventDefault>
                <label for="natural-search">دنبال چه قطعه‌ای هستید؟</label>
                <div class="search-field">
                    <input id="natural-search" type="search" maxlength="200" @bind="_input" placeholder="مثلاً انگشتر مینیمال برای استفاده روزانه" />
                    <button type="submit">پیدا کن</button>
                </div>
            </form>
        </div>
    </section>
    <section class="inner-content" aria-labelledby="results-title">
        <div class="storefront-container">
            @if (!string.IsNullOrWhiteSpace(Query))
            {
                <h2 id="results-title">نتیجه برای «@Query»</h2>
                @if (_loading)
                {
                    <div class="search-loading" role="status" aria-label="در حال یافتن قطعات مناسب">
    <div class="search-loading-mark" aria-hidden="true">
        <span class="search-loading-orbit search-loading-orbit-one"></span>
        <span class="search-loading-orbit search-loading-orbit-two"></span>
        <span class="search-loading-core">
            <svg viewBox="0 0 48 48" focusable="false" aria-hidden="true">
                <path d="M24 4c1.8 11.2 8.8 18.2 20 20-11.2 1.8-18.2 8.8-20 20C22.2 32.8 15.2 25.8 4 24 15.2 22.2 22.2 15.2 24 4Z" />
            </svg>
        </span>
    </div>
    <p>پیشنهادهای مخصوص شما در راه‌اند…</p>
</div>
                }
                else if (_results.Count == 0)
                {
                    <p role="status">قطعهٔ مرتبطی پیدا نشد. نام، دسته یا رنگ دیگری را امتحان کنید.</p>
                }
                else
                {
                    <p class="result-count" role="status">@_results.Count قطعهٔ موجود پیدا شد.@if (_usedAi) { <span> پیشنهاد با کمک هوش مصنوعی</span> }</p>
                    <div class="search-results">
                        @foreach (var product in _results)
                        {
                            <ProductCard Code="@product.Code" Title="@product.Title" Price="@product.Price" ImageUrl="@product.ImageUrl" Href="@product.Href" Available="@product.Available" />
                        }
                    </div>
                }
            }
            else
            {
                <h2 id="results-title">از یک توصیف ساده شروع کنید</h2>
                <p>نام قطعه، رنگ یا سبک دلخواهتان را در کادر بالا بنویسید.</p>
            }
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? Query { get; set; }
    private string _input = string.Empty;
    private bool _loading;
    private bool _usedAi;
    private IReadOnlyList<StorefrontProductCard> _results = [];

    protected override async Task OnParametersSetAsync()
    {
        _input = Query ?? string.Empty;
        _results = [];
        _usedAi = false;
        if (string.IsNullOrWhiteSpace(Query)) return;
        _loading = true;
        try
        {
            var result = await AiSearch.SearchAsync(await Catalog.SearchableProductsAsync(), Query);
            _results = result.Products;
            _usedAi = result.UsedAi;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Search()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            Navigation.NavigateTo("/products/search?q=" + Uri.EscapeDataString(_input.Trim()));
    }
}