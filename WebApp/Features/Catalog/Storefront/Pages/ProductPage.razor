@page "/products/{Id}"
@layout StorefrontLayout
@using MerdasGold.Features.Catalog.Services
@inject StorefrontCatalogService Catalog
@inject NavigationManager Navigation

@if (_product is not null)
{
    <PageTitle>@_product.Title | مرداس</PageTitle>
    <ProductDetailView Product="_product" />
}
@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private StorefrontProduct? _product;
    protected override async Task OnParametersSetAsync()
    {
        _product = await Catalog.ProductAsync(Id);
        if (_product is null) Navigation.NotFound();
    }
}
