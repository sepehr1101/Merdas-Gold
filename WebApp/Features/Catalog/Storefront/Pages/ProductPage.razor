@page "/products/{Id}"
@layout StorefrontLayout
@attribute [StreamRendering]
@using MerdasGold.Features.Catalog.Services
@inject StorefrontCatalogService Catalog
@inject NavigationManager Navigation

@if (_loading)
{
    <ProductDetailSkeleton />
}
else if (_product is not null)
{
    <PageTitle>@_product.Title | مرداس</PageTitle>
    <ProductDetailView Product="_product" ProductHref="@($"/products/{Id}")" />
}
@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private StorefrontProduct? _product;
    private bool _loading = true;
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _product = await Catalog.ProductAsync(Id);
            if (_product is null) Navigation.NotFound();
        }
        finally
        {
            _loading = false;
        }
    }
}
