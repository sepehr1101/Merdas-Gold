@implements IDisposable
@using MerdasGold.Features.Catalog.Services
@inject StorefrontCatalogService Catalog
@inject StorefrontUiState UiState

@if (Product is not null)
{
    <div class="demo-product-page">
        <div class="product-page-top">
            <nav class="storefront-container product-breadcrumb" aria-label="مسیر صفحه">
                <a href="/">خانه</a><span aria-hidden="true">/</span>
                <a href="/products/category/@Product.CategorySlug">@Product.CategoryName</a><span aria-hidden="true">/</span>
                <span aria-current="page">@Product.Title</span>
            </nav>
        </div>
        <section class="inner-content" aria-labelledby="product-title">
            <div class="storefront-container">
                <div class="product-detail">
                    <div class="product-visual">
                        <ProductGallery Title="@Product.Title" Images="@Product.Images" />
                    </div>
                    <div class="product-summary">
                        <h1 id="product-title">@Product.Title <span class="product-code" dir="ltr">(@Product.Code)</span></h1>
                        <p class="product-price">@(_price is null ? "در انتظار قیمت‌گذاری" : $"{_price:N0} تومان")</p>
                        <div class="variant-picker" aria-label="انتخاب تنوع محصول">
                            <h2>انتخاب رنگ و مدل</h2>
                            <p>هر تنوع، وزن و موجودی خودش را دارد.</p>
                            <div class="variant-options">
                                @foreach (var variant in Product.Variants)
                                {
                                    <button type="button" class="variant-option @(variant.Id == _selected?.Id ? "selected" : null)"
                                            disabled="@(!variant.Available || _quoting)"
                                            aria-pressed="@(variant.Id == _selected?.Id ? "true" : "false")"
                                            @onclick="() => SelectVariantAsync(variant)">
                                        <span class="color-swatch" style="background-color:@variant.ColorHex" aria-hidden="true"></span>
                                        <span><strong>@variant.Color</strong><small>@variant.Title</small></span>
                                        @if (!variant.Available) { <em>ناموجود</em> }
                                    </button>
                                }
                            </div>
                        </div>
                        @if (_selected is not null)
                        {
                            <div class="selected-variant" aria-live="polite">
                                <span>رنگ: <strong>@_selected.Color</strong></span>
                                @if (!string.IsNullOrWhiteSpace(_selected.Size))
                                {
                                    <span>@Product.SizeLabel: <strong>@_selected.Size @Product.SizeUnit</strong></span>
                                }
                                <span>وزن دقیق: <strong>@_selected.Weight.ToString("0.000") گرم</strong></span><span>موجودی: <strong>@_selected.Quantity عدد</strong></span>
                            </div>
                        }
                        <div class="product-actions">
                            <button class="storefront-action product-add" type="button" disabled="@(Preview || _selected is null || _adding)" aria-busy="@_adding.ToString().ToLowerInvariant()" @onclick="AddToCartAsync">
                                @if (_adding) { <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-hidden="true" /> <span>در حال افزودن…</span> }
                                else { <span>افزودن به سبد خرید</span> }
                            </button>
                            @if (!Preview)
                            {
                                <button class="product-favorite @(IsFavorite ? "is-favorite" : null)" type="button"
                                        aria-pressed="@IsFavorite.ToString().ToLowerInvariant()"
                                        @onclick="ToggleFavoriteAsync">
                                    <span aria-hidden="true">@(IsFavorite ? "♥" : "♡")</span>
                                    @(IsFavorite ? "حذف از علاقه‌مندی‌ها" : "افزودن به علاقه‌مندی‌ها")
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <details class="product-information">
                    <summary><span>درباره این قطعه</span><span class="accordion-chevron" aria-hidden="true">⌄</span></summary>
                    <div class="product-description">
                        <p>@Product.Description</p>
                        <p class="image-note">تصویر این کالای نمونه ممکن است با نوع کالا متفاوت باشد.</p>
                    </div>
                </details>
                <details class="product-information">
                    <summary><span>مشخصات قطعه</span><span class="accordion-chevron" aria-hidden="true">⌄</span></summary>
                    <div class="specs-content">
                        <dl class="product-specs">
                            <div><dt>نوع کالا</dt><dd>@Product.ProductType</dd></div>
                            @foreach (var item in Product.Attributes)
                            {
                                <div><dt>@item.Key</dt><dd>@DisplayValue(item.Key, item.Value)</dd></div>
                            }
                            <div><dt>کد محصول</dt><dd dir="ltr">@Product.Code</dd></div>
                        </dl>
                    </div>
                </details>
                @if (Product.Tags.Length > 0)
                {
                    <details class="product-information">
                        <summary><span>برچسب‌های این قطعه</span><span class="accordion-chevron" aria-hidden="true">⌄</span></summary>
                        <nav class="product-tag-list" aria-label="برچسب‌های این قطعه">
                            @foreach (var tag in Product.Tags)
                            {
                                <a href="@($"/products/tag/{Uri.EscapeDataString(tag.Slug)}")">@tag.Name</a>
                            }
                        </nav>
                    </details>
                }
                <section class="related-products" aria-labelledby="related-title">
                    <div class="related-heading"><h2 id="related-title">محصولات همین دسته</h2><a href="/products/category/@Product.CategorySlug">دیدن همه</a></div>
                    <div class="related-grid">
                        @foreach (var related in Product.Related)
                        {
                            <ProductCard Code="@related.Code" Title="@related.Title" Price="@related.Price" ImageUrl="@related.ImageUrl" Href="@related.Href" Available="@related.Available" />
                        }
                    </div>
                </section>
            </div>
        </section>
    </div>
}
@code {
    [Parameter, EditorRequired] public StorefrontProduct? Product { get; set; }
    [Parameter] public bool Preview { get; set; }
    [Parameter] public string ProductHref { get; set; } = string.Empty;
    private bool IsFavorite => UiState.IsFavorite(ProductHref);
    protected override void OnInitialized() => UiState.Changed += OnShopperChanged;
    private StorefrontVariant? _selected;
    private decimal? _price;
    private bool _quoting;
    private bool _adding;
    protected override async Task OnParametersSetAsync()
    {
        _selected = Product?.Variants.FirstOrDefault(x => x.Available);
        _price = _selected is not null ? (await (Preview ? Catalog.PreviewQuoteAsync(_selected.Id) : Catalog.QuoteAsync(_selected.Id)))?.Breakdown.Total : null;
    }
    private async Task SelectVariantAsync(StorefrontVariant variant)
    {
        if (!variant.Available || _quoting) return;
        _selected = variant;
        _quoting = true;
        try
        {
            _price = (await (Preview ? Catalog.PreviewQuoteAsync(variant.Id) : Catalog.QuoteAsync(variant.Id)))?.Breakdown.Total;
        }
        finally
        {
            _quoting = false;
        }
    }
    private async Task AddToCartAsync()
    {
        if (Preview || Product is null || _selected is null || _adding) return;
        _adding = true;
        try
        {
            await UiState.AddToCartAsync(new(Product.Code, Product.Title, ProductHref,
                Product.Images.FirstOrDefault() ?? "", _selected.Id, _selected.Title,
                _selected.Color, _selected.Size, _selected.Weight, 1), _selected.Quantity);
        }
        finally
        {
            _adding = false;
        }
    }
    private Task ToggleFavoriteAsync() =>
        Product is null || Preview ? Task.CompletedTask :
        UiState.ToggleFavoriteAsync(new(Product.Code, Product.Title, ProductHref,
            Product.Images.FirstOrDefault() ?? ""));
    private void OnShopperChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => UiState.Changed -= OnShopperChanged;
    private static string DisplayValue(string name, string value) => name == "عیار" && value == "18" ? "۱۸ عیار" : value;
}
