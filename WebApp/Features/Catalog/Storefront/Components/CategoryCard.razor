<a class="category-card" href="@Href">
    @if (!string.IsNullOrWhiteSpace(ImageUrl)) { <img src="@ImageUrl" alt="" width="450" height="445" loading="lazy" /> }
    else { <span class="category-fallback" aria-hidden="true"></span> }
    <b>@Title</b>
</a>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string? ImageUrl { get; set; }

    [Parameter]
    public string Href { get; set; } = "#products";
}
