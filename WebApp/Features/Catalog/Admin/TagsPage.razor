@page "/admin/catalog/tags"
@layout AdminLayout
@attribute [Authorize(Roles="Administrator")]
<PageTitle>برچسب‌های محصولات | مرداس گلد</PageTitle>

<section class="manage-page tags-page">
    <a class="back-link" href="/admin/catalog"><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small"/> بازگشت به کالاها</a>
    <header class="page-header"><div><span class="eyebrow">گروه‌بندی سریع</span><MudText Typo="Typo.h4" HtmlTag="h1" Class="page-title">برچسب‌ها</MudText></div><a class="primary-action" href="/admin/catalog/tags?edit=0"><MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small"/> برچسب جدید</a></header>
    @if (Message is not null) { <div class="notice @(Error is null ? "success" : "error")">@Message</div> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary"/> }
    else {
        <div class="management-toolbar"><label><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small"/><input placeholder="جست‌وجوی عنوان یا نامک برچسب" @bind="_search" @bind:event="oninput"/></label><div class="segments"><button class="@(_stateFilter == "all" ? "active" : "")" @onclick="ShowAll">همه</button><button class="@(_stateFilter == "active" ? "active" : "")" @onclick="ShowActive">فعال</button><button class="@(_stateFilter == "unused" ? "active" : "")" @onclick="ShowUnused">بدون استفاده</button></div><span>@FilteredItems.Count برچسب</span></div>
        @if (_editor is not null) {
            <article class="edit-card compact-card"><header><span><MudIcon Icon="@Icons.Material.Outlined.Sell"/></span><div><h2>@(_editor.Id == 0 ? "برچسب تازه" : "ویرایش برچسب")</h2></div></header><form method="post" action="/account/catalog/tags/save" data-enhance="false"><AntiforgeryToken/><input type="hidden" name="Id" value="@_editor.Id"/><input type="hidden" name="RowVersion" value="@_editor.RowVersion"/><div class="form-grid"><label class="field"><span>عنوان *</span><input name="Name" value="@_editor.Name" maxlength="100" required/></label><label class="field"><span>نامک آدرس *</span><input name="Slug" value="@_editor.Slug" maxlength="120" dir="ltr" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="best-seller" required/></label></div><div class="form-actions"><label class="toggle-field"><input type="checkbox" name="IsActive" value="true" checked="@_editor.IsActive"/><input type="hidden" name="IsActive" value="false"/><i></i>فعال باشد</label><div><a href="/admin/catalog/tags">انصراف</a><button type="submit">ذخیره برچسب</button></div></div></form></article>
            @if (_editor.Id > 0) { <form class="delete-zone standalone" method="post" action="/account/catalog/tags/delete" data-enhance="false" onsubmit="return confirm('این برچسب حذف شود؟');"><AntiforgeryToken/><input type="hidden" name="Id" value="@_editor.Id"/><input type="hidden" name="RowVersion" value="@_editor.RowVersion"/><span><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small"/> برچسب متصل به محصول قابل حذف نیست؛ ابتدا آن را غیرفعال کنید یا اتصال را بردارید.</span><button type="submit"><MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"/> حذف برچسب</button></form> }
        }
        <div class="summary-strip"><span><MudIcon Icon="@Icons.Material.Outlined.Sell"/></span><div><strong>@_items.Count برچسب</strong><small>@_items.Count(x => x.IsActive) فعال</small></div><div><strong>@_items.Sum(x => x.ProductCount) اتصال</strong><small>@_items.Count(x => x.ProductCount == 0) برچسب بدون استفاده</small></div></div>
        <div class="tag-cloud">@foreach (var item in FilteredItems) { <a class="tag-tile @(item.IsActive ? "" : "disabled")" href="/admin/catalog/tags?edit=@item.Id"><span><MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small"/>@item.Name</span><small>@item.ProductCount محصول</small><b dir="ltr">@item.Slug</b><i class="tag-state">@(item.IsActive ? "فعال" : "غیرفعال")</i></a> }@if (FilteredItems.Count == 0) { <div class="compact-empty"><MudIcon Icon="@Icons.Material.Outlined.SearchOff"/><strong>برچسبی پیدا نشد</strong><span>عبارت جست‌وجو یا فیلتر را تغییر دهید.</span></div> }</div>
    }
</section>
