@page "/admin/catalog"
@layout AdminLayout
@attribute [Authorize(Roles="Administrator")]
<PageTitle>کالاها | مرداس گلد</PageTitle>
<section class="catalog-hub">
 <header class="admin-hub-hero"><div class="admin-hub-hero-copy"><span class="admin-hub-eyebrow"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small"/> کاتالوگ هوشمند فروشگاه</span><MudText Typo="Typo.h3" HtmlTag="h1" Class="admin-hub-title">هر قطعه، با هویت دقیق خودش</MudText></div><div class="admin-hub-emblem" aria-hidden="true"><span></span><MudIcon Icon="@Icons.Material.Outlined.Diamond"/></div></header>
 @if(_loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary"/>}else{
 <div class="admin-hub-grid">
  <a class="admin-hub-card accent-primary" href="/admin/catalog/products"><span class="admin-hub-number">01</span><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.Inventory2"/></span><div class="admin-hub-copy"><h2>محصولات</h2><p>ساخت محصول، تعریف تنوع و ثبت وزن دقیق هر قطعه.</p></div><footer class="admin-hub-footer"><span>@(_overview?.ProductCount??0) محصول</span><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"/></footer></a>
  <a class="admin-hub-card accent-green" href="/admin/catalog/categories"><span class="admin-hub-number">02</span><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.AccountTree"/></span><div class="admin-hub-copy"><h2>دسته‌بندی‌ها</h2><p>ساخت مسیرهای مرتب برای پیدا کردن سریع‌تر محصولات.</p></div><footer class="admin-hub-footer"><span>@(_overview?.CategoryCount??0) دسته فعال</span><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"/></footer></a>
  <a class="admin-hub-card accent-gold" href="/admin/catalog/structure"><span class="admin-hub-number">03</span><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.Tune"/></span><div class="admin-hub-copy"><h2>الگو و ویژگی‌ها</h2><p>فرم آماده هر نوع کالا و مشخصات قابل استفاده مجدد.</p></div><footer class="admin-hub-footer"><span>@(_overview?.TypeCount??0) الگو · @(_overview?.AttributeCount??0) ویژگی</span><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"/></footer></a>
  <a class="admin-hub-card accent-blue" href="/admin/catalog/tags"><span class="admin-hub-number">04</span><span class="admin-hub-icon"><MudIcon Icon="@Icons.Material.Outlined.Sell"/></span><div class="admin-hub-copy"><h2>برچسب‌ها</h2><p>نشانه‌های منعطف برای کمپین‌ها و کشف بهتر کالاها.</p></div><footer class="admin-hub-footer"><span>مدیریت برچسب‌ها</span><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"/></footer></a>
 </div>}
</section>
